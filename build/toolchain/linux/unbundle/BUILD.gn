import("//build/toolchain/gcc_toolchain.gni")

gcc_toolchain("default") {
  cc = getenv("CC")
  cxx = getenv("CXX")
  ar = getenv("AR")
  nm = getenv("NM")
  ld = cxx

  extra_cflags = getenv("CFLAGS")
  extra_cppflags = getenv("CPPFLAGS")
  extra_cxxflags = getenv("CXXFLAGS")
  extra_ldflags = getenv("LDFLAGS")

  toolchain_args = {
    current_cpu = current_cpu
    current_os = current_os
  }
}

gcc_toolchain("host") {
  cc = getenv("CC")
  cxx = getenv("CXX")
  ar = getenv("AR")
  nm = getenv("NM")
  ld = cxx

  extra_cflags = getenv("CFLAGS_FOR_BUILD")
  extra_cppflags = getenv("CPPFLAGS_FOR_BUILD")
  extra_cxxflags = getenv("CXXFLAGS_FOR_BUILD")
  extra_ldflags = getenv("LDFLAGS_FOR_BUILD")

  toolchain_args = {
    current_cpu = current_cpu

    if (deb_build_cpu != "") {
      current_cpu = deb_build_cpu
    }

    current_os = current_os
  }
}
